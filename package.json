{
  "name": "@yorganci/magika-burn",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "description": "Google's Magika file content type detection, compiled from Rust to WebAssembly with Burn",
  "author": {
    "name": "Atahan Yorgancı",
    "email": "atahanyorganci@hotmail.com"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/atahanyorganci/magika-burn#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atahanyorganci/magika-burn.git"
  },
  "bugs": {
    "url": "https://github.com/atahanyorganci/magika-burn/issues"
  },
  "keywords": [
    "magika",
    "file-type",
    "mime-type",
    "content-type",
    "detection",
    "wasm",
    "webassembly"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "node": {
        "types": "./pkg/nodejs/magika.d.ts",
        "default": "./pkg/nodejs/magika.js"
      },
      "default": {
        "types": "./pkg/web/magika.d.ts",
        "default": "./pkg/web/magika.js"
      }
    },
    "./magika_bg.wasm": "./pkg/web/magika_bg.wasm",
    "./package.json": "./package.json"
  },
  "main": "./pkg/nodejs/magika.js",
  "types": "./pkg/nodejs/magika.d.ts",
  "files": [
    "pkg/nodejs/",
    "pkg/web/",
    "assets/LICENSE"
  ],
  "scripts": {
    "build": "scripts/build-wasm.sh web nodejs",
    "test": "node --test 'tests/wasm/*.test.mjs'",
    "prepack": "pnpm run build"
  },
  "dependencies": {},
  "devDependencies": {}
}
